# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.advisor.local.example
!.env.creative-workers.local.example
!.env.production-workers.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Dev OS runtime artifacts -- these MUST be ignored, or the merge gates see a
# permanently dirty tree and refuse to merge anything.
claude-session.log
automation.lock
.last-phase-result.txt

# Daily AI Advisor -- generated reports are never committed to main (see DAILY_AI_ADVISOR.md
# section on git publishing); daily-advisor.ps1 copies them into a dedicated worktree that
# publishes to the automation/daily-advisor branch instead. This local output/ dir and worktree
# are just staging areas.
daily-advisor-session.log
/daily-advisor/output/
/daily-advisor/.run.lock

# Creative Package Preparation (PROP-034) -- same reasoning as Daily Advisor above: generated
# per-run output and the lock file are local operational artifacts, never committed.
/creative-prep/output/
/creative-prep/.run.lock

# Creative AI background worker (S3D) -- the single-instance lock file the scheduled one-shot
# process takes each run. Purely a local operational artifact, like the two above.
/creative-ai-worker/.run.lock

# Marketing Advisor manual export/import sessions (PROP-021) -- local working artifacts (Brief
# snapshots, prompts, manifests, AI replies, lifted drafts), never committed. Mirrors the Daily
# Advisor output/ convention above.
/marketing-advisor/output/

# Production MVP machine executors (Wave B) -- generated experiment/acceptance output. Same reasoning
# as the four generated-output directories above: these are large local evidence trees (PNGs, raw
# provider responses, review HTML) produced by the spike/acceptance harness for owner review, not
# source. The accepted visual decisions they supported live in the review record, not in git.
/outputs/

# Wave B exploratory render spikes -- kept on local disk as owner evidence, excluded from the repo.
# These four each carry their own private copy of the satori element types and compositions they were
# exploring; all of that was superseded by src/lib/production-static-renderer.ts, and none of them
# imports it. Retaining them would ship ~2,000 lines of dead alternative renderers alongside the real
# one. render-owner-visual-correction.ts is deliberately NOT listed here -- it is the one harness that
# drives the real renderer, and it stays tracked.
/scripts/production-static-renderer/render-static-spike.ts
/scripts/production-static-renderer/render-final-composition-spike.ts
/scripts/production-static-renderer/render-reference-illustration-spike.ts
/scripts/production-static-renderer/render-reference-model-spike.ts

/.worktrees/
