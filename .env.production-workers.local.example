# Copy to .env.production-workers.local and fill in real values.
#
# Only read by the Production MVP machine executors:
#   node scripts/asset-workers/run.ts run --job-id <id> --worker generative_image
#
# The static_renderer worker needs NONE of this -- it is deterministic, local, and calls no API:
#   node scripts/asset-workers/run.ts run --job-id <id> --worker static_renderer
#
# The export/import (manual, human/external creative workspace) subcommands also read none of this
# and never require an API key.

# REQUIRED MIGRATION for generative_image: supabase-add-asset-job-attempt-provenance.sql must be
# applied to this Supabase project first. The generative_image worker records provider/model
# provenance onto asset_job_attempts, and the RPC that writes it is created by that file. Without it
# the asset is still produced correctly, but attempt bookkeeping fails and the worker exits non-zero.
# static_renderer, export and import do not need it.

# --- Cloudflare Workers AI (generative_image) ---
# Required. Both must be set or the generative_image executor refuses to start.
# The API token needs Workers AI read/run permission only -- do not reuse an account-wide token.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. Overrides the built-in default model
# (see DEFAULT_CLOUDFLARE_GENERATIVE_IMAGE_MODEL in src/lib/production-asset-executors.ts).
# Provider and model are configuration, not identity -- changing this does not change any contract.
CLOUDFLARE_GENERATIVE_IMAGE_MODEL=

# --- Reference images (optional) ---
# Semicolon-separated ABSOLUTE paths to operator-approved local style-reference images.
# Semicolon, not comma: a Windows path never contains ";" but may legitimately contain ",".
#
# These are style anchors only. The prompt instructs the model to take broad visual language
# (warmth, palette, linework, texture, density) from them and explicitly NOT to copy artwork,
# characters, pose, text or composition.
#
# Enforced limits (src/lib/production-asset-executors.ts):
#   - at most 4 references
#   - at most 4 MiB each
#   - PNG, JPEG or WebP only, decided by decoding real magic bytes, never by file extension
#   - an unreadable, empty, oversized or undecodable reference FAILS the job -- it is never
#     silently skipped into a reference-free generation
#
# Leave empty to generate with no references.
# Example shape only -- never commit real paths, and never point this at anything unlicensed:
#   GENERATIVE_IMAGE_REFERENCE_PATHS=C:\path\to\approved-reference-a.png;C:\path\to\approved-reference-b.jpg
GENERATIVE_IMAGE_REFERENCE_PATHS=
