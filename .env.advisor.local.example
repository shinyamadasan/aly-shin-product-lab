# Copy this file to .env.advisor.local and fill in real values. .env.advisor.local is gitignored
# (see .gitignore's "env files" section) -- never commit real credentials.
#
# Required only for `--source supabase`. `--source sample` needs none of these.
#
# Use a DEDICATED Supabase Auth user for this worker, not your own login and not the
# service-role key. See DAILY_AI_ADVISOR.md section 6 and scripts/daily-advisor/README.md for why.
ADVISOR_SUPABASE_URL=
ADVISOR_SUPABASE_ANON_KEY=
ADVISOR_SUPABASE_EMAIL=
ADVISOR_SUPABASE_PASSWORD=

# Optional. Defaults to Asia/Manila if unset.
ADVISOR_TIMEZONE=Asia/Manila

# Optional. Defaults to "claude" (resolved from PATH) if unset.
ADVISOR_CLAUDE_BIN=claude
